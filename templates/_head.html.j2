        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <link rel="icon" href="assets/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="{{ avatar }}" />

        <!-- Apply the saved theme before first paint to avoid a flash -->
        <script>
            try {
                var t = localStorage.getItem("theme");
                if (t) document.documentElement.setAttribute("data-theme", t);
            } catch (e) {}
        </script>

        <!-- Self-hosted fonts (OFL, see assets/fonts/): preload the two used above the fold -->
        <link rel="preload" href="assets/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="assets/fonts/PressStart2P-Regular.woff2" as="font" type="font/woff2" crossorigin />

        <link rel="stylesheet" href="style.css" />
        {% if goatcounter %}

        <!-- Privacy-friendly visit counter (no cookies): https://www.goatcounter.com -->
        <script data-goatcounter="https://{{ goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
        {% endif %}
