<!doctype html>
<!-- Generated by scripts/build.py from info/*.json — edit those, not this file. -->
<html lang="en">
    <head>
{% include "_head.html.j2" %}
        <title>{{ info.name }} – Research Homepage</title>
        <meta name="description" content="{{ description }}" />
        <link rel="canonical" href="{{ site_url }}" />

        <!-- Open Graph / Twitter -->
        <meta property="og:type" content="profile" />
        <meta property="og:site_name" content="{{ info.name }}" />
        <meta property="og:title" content="{{ info.name }} – Research Homepage" />
        <meta property="og:description" content="{{ description }}" />
        <meta property="og:url" content="{{ site_url }}" />
        {% if og_image %}
        <meta property="og:image" content="{{ site_url }}{{ og_image }}" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="{{ info.name }}: {{ info.title }}" />
        <meta name="twitter:card" content="summary_large_image" />
        {% else %}
        <meta name="twitter:card" content="summary" />
        {% endif %}
        {% if twitter_handle %}
        <meta name="twitter:site" content="{{ twitter_handle }}" />
        <meta name="twitter:creator" content="{{ twitter_handle }}" />
        {% endif %}

        <script type="application/ld+json">
{{ json_ld }}
        </script>
    </head>
    <body class="bg-body-custom">
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="page">
            <main id="main" class="page-main">
                <div class="layout">
                    <!-- Sidebar / Profile -->
                    <aside class="sidebar">
                        <div class="sidebar-card">
                            <div class="profile-header">
                                {% if avatar %}
                                <div class="profile-photo-wrapper">
                                    <picture>
                                        {% if avatar_webp %}
                                        <source srcset="{{ avatar_webp }}" type="image/webp" />
                                        {% endif %}
                                        <img
                                            class="profile-photo"
                                            src="{{ avatar }}"
                                            alt="Portrait of {{ info.name }}"
                                            {% if avatar_w %}width="{{ avatar_w }}" height="{{ avatar_h }}"{% endif %}
                                        />
                                    </picture>
                                </div>
                                {% endif %}
                                <h1 class="profile-name">{{ info.name }}</h1>
                                <div class="profile-title">{{ info.title }}</div>
                                <div class="profile-affiliation">{{ affiliation }}</div>
                                {% if info.location and info.location != info.affiliation2 %}
                                <div class="profile-location">{{ info.location }}</div>
                                {% endif %}
                            </div>

                            {% if emails %}
                            <div class="sidebar-block">
                                <h2 class="section-label">Contact</h2>
                                {% for e in emails %}
                                <div class="profile-text">
                                    <a class="js-email" href="#" data-user="{{ e.user }}" data-domain="{{ e.domain }}">{{ e.user }} [at] {{ e.domain }}</a>
                                </div>
                                {% endfor %}
                            </div>
                            {% endif %}

                            {% if social %}
                            <div class="sidebar-block">
                                <h2 class="section-label">Online</h2>
                                <div class="chip-row">
                                    {% for link in social %}
                                    <a class="profile-chip" href="{{ link.url }}" target="_blank" rel="noopener me">{{ link.label }}</a>
                                    {% endfor %}
                                </div>
                            </div>
                            {% endif %}

                            {% if info.researchTopics %}
                            <div class="sidebar-block">
                                <h2 class="section-label">Research Interests</h2>
                                <ul class="research-topics">
                                    {% for topic in info.researchTopics %}
                                    <li>{{ topic }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                            {% endif %}

                            {% if info.openToInternships and info.internshipNote %}
                            <div class="sidebar-block">
                                <h2 class="section-label">Internships</h2>
                                <div class="internship-note">{{ info.internshipNote }}</div>
                            </div>
                            {% endif %}

                            {% if info.cvUrl %}
                            <div class="sidebar-block">
                                <h2 class="section-label">CV</h2>
                                <div class="profile-text">
                                    <a href="{{ info.cvUrl }}" target="_blank" rel="noopener">Download CV (PDF)</a>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </aside>

                    <!-- Main content -->
                    <div class="content">
                        <!-- Top section nav -->
                        <nav class="sections-card" aria-label="Sections">
                            <div class="sections-nav">
                                <div class="sections-label" aria-hidden="true">Sections</div>
                                <div class="nav-links">
                                    <a class="nav-link-compact" href="#about">About</a>
                                    {% if news %}<a class="nav-link-compact" href="#news">News</a>{% endif %}
                                    {% if pub_groups %}<a class="nav-link-compact" href="#publications">Publications</a>{% endif %}
                                    <a class="nav-link-compact" href="#activities">Activities</a>
                                </div>
                                <button
                                    type="button"
                                    class="theme-toggle"
                                    id="theme-toggle"
                                    aria-label="Toggle dark mode"
                                    title="Toggle dark mode"
                                    hidden
                                >
                                    <span aria-hidden="true">◐</span>
                                </button>
                            </div>
                        </nav>

                        <!-- About -->
                        <section id="about" class="card-section">
                            <h2 class="section-title">About Me</h2>
                            <div class="section-body">
                                {% if tagline %}
                                <p class="about-lead">{{ tagline }}</p>
                                {% endif %}
                                {% for p in about %}
                                <p>{{ p }}</p>
                                {% endfor %}
                            </div>
                        </section>

                        {% if news %}
                        <!-- News -->
                        <section id="news" class="card-section">
                            <h2 class="section-title">News</h2>
                            <ul class="section-list news-list">
                                {% for item in news %}
                                <li>
                                    <span class="news-date">{{ item.label }}</span>
                                    <span>
                                        {% if item.url %}
                                        <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.text }}</a>
                                        {% else %}
                                        {{ item.text }}
                                        {% endif %}
                                    </span>
                                </li>
                                {% endfor %}
                            </ul>
                        </section>
                        {% endif %}

                        {% if pub_groups %}
                        <!-- Publications -->
                        <section id="publications" class="card-section">
                            <h2 class="section-title">Publications</h2>
                            {% for group in pub_groups %}
                            <h3 class="pub-year">{{ group.year }}</h3>
                            <div class="pub-list-cards">
                                {% for pub in group.pubs %}
                                <article class="pub-card">
                                    <h4 class="pub-card-title">
                                        {% if pub.venueShort %}<span class="pub-venue-badge">{{ pub.venueShort }}</span>{% endif %}
                                        {% if pub.primaryUrl %}
                                        <a class="pub-card-link" href="{{ pub.primaryUrl }}" target="_blank" rel="noopener">{{ pub.title }}</a>
                                        {% else %}
                                        {{ pub.title }}
                                        {% endif %}
                                    </h4>
                                    <div class="pub-card-meta">
                                        {% for a in pub.authorList %}{% if a.me %}<strong>{{ a.name }}</strong>{% else %}{{ a.name }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                                        {% if pub.venue %}<br /><em>{{ pub.venue }}</em>{% endif %}{% if pub.year %}, {{ pub.year }}{% endif %}
                                    </div>
                                    {% if pub.tldr %}
                                    <p class="pub-tldr">{{ pub.tldr }}</p>
                                    {% endif %}

                                    {% if pub.image %}
                                    <div class="pub-card-image-block">
                                        <button type="button" class="pub-figure-link" data-full="{{ pub.imageWebp or pub.image }}" aria-label="Enlarge figure for “{{ pub.title }}”">
                                            <picture>
                                                {% if pub.imageWebp %}
                                                <source srcset="{{ pub.imageWebp }}" type="image/webp" />
                                                {% endif %}
                                                <img
                                                    class="pub-card-image"
                                                    src="{{ pub.image }}"
                                                    alt="Overview figure for “{{ pub.title }}”"
                                                    loading="lazy"
                                                    decoding="async"
                                                    {% if pub.imageWidth %}width="{{ pub.imageWidth }}" height="{{ pub.imageHeight }}"{% endif %}
                                                />
                                            </picture>
                                            <span class="pub-figure-hint" aria-hidden="true">⤢ Enlarge</span>
                                        </button>
                                    </div>
                                    {% endif %}

                                    <div class="pub-card-chips">
                                    {% for chip in pub.chips %}
                                    <a class="pub-chip" href="{{ chip.url }}" target="_blank" rel="noopener">{{ chip.label }}</a>
                                    {% endfor %}
                                    {% if pub.summary %}
                                    <details class="pub-details">
                                        <summary class="pub-chip">Abstract</summary>
                                        <p class="pub-abstract">{{ pub.summary }}</p>
                                    </details>
                                    {% endif %}
                                    <details class="pub-details">
                                        <summary class="pub-chip">BibTeX</summary>
                                        <div class="pub-bibtex-wrap">
                                            <button type="button" class="pub-chip pub-copy" hidden>Copy</button>
                                            <pre class="pub-bibtex">{{ pub.bibtex }}</pre>
                                        </div>
                                    </details>
                                    </div>
                                </article>
                                {% endfor %}
                            </div>
                            {% endfor %}
                        </section>
                        {% endif %}

                        <!-- Teaching, talks, projects, honors & service -->
                        <section id="activities" class="card-section">
                            <h2 class="section-title">Academic Activities</h2>
                            {% if talks %}
                            <h3 class="section-subheading">Talks</h3>
                            <ul class="section-list">
                                {% for t in talks %}
                                <li>
                                    {% if t.label %}<span class="teaching-term">{{ t.label }}</span>{% endif %}
                                    {% if t.url %}<a href="{{ t.url }}" target="_blank" rel="noopener">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}{% if t.event %} — {{ t.event }}{% endif %}
                                </li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                            {% if projects %}
                            <h3 class="section-subheading">Projects</h3>
                            <ul class="section-list">
                                {% for p in projects %}
                                <li>
                                    {% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}{% if p.description %} — {{ p.description }}{% endif %}
                                </li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                            {% if teaching %}
                            <h3 class="section-subheading">Teaching</h3>
                            <ul class="section-list">
                                {% for t in teaching %}
                                <li>
                                    <span class="teaching-term">{{ t.term }}</span>
                                    {% if t.url %}<a href="{{ t.url }}" target="_blank" rel="noopener">{{ t.course }}</a>{% else %}{{ t.course }}{% endif %}{% if t.role %} — {{ t.role }}{% endif %}
                                </li>
                                {% endfor %}
                            </ul>
                            {% endif %}
                            {% if awards %}
                            <h3 class="section-subheading">Honors &amp; Awards</h3>
                            <ul class="section-list">
                                {% for a in awards %}<li>{{ a }}</li>{% endfor %}
                            </ul>
                            {% endif %}
                            {% if service %}
                            <h3 class="section-subheading">Service</h3>
                            <ul class="section-list">
                                {% for s in service %}<li>{{ s }}</li>{% endfor %}
                            </ul>
                            {% endif %}
                        </section>
                    </div>
                </div>
            </main>

            <footer class="site-footer">
                <div class="footer-inner">
                    <div>© {{ year }} {{ info.name }}</div>
                    <div>{{ footer_note }} · Last updated {{ today }}</div>
                </div>
            </footer>
        </div>

        <!-- Figure lightbox (opened by site.js) -->
        <dialog class="lightbox" id="lightbox" aria-label="Enlarged figure">
            <form method="dialog">
                <button class="pub-chip lightbox-close" aria-label="Close">Close ✕</button>
            </form>
            <img class="lightbox-img" alt="" />
        </dialog>

        <script src="site.js" defer></script>
    </body>
</html>
