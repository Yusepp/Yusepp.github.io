<!doctype html>
<!-- Generated by scripts/build.py from info/*.json — edit those, not this file. -->
<html lang="en">
    <head>
{% include "_head.html.j2" %}
        <title>{{ info.name }} – Research Homepage</title>
        <meta name="description" content="{{ description }}" />
        <link rel="canonical" href="{{ site_url }}" />

        <!-- Open Graph / Twitter -->
        <meta property="og:type" content="profile" />
        <meta property="og:site_name" content="{{ info.name }}" />
        <meta property="og:title" content="{{ info.name }} – Research Homepage" />
        <meta property="og:description" content="{{ description }}" />
        <meta property="og:url" content="{{ site_url }}" />
        {% if avatar %}
        <meta property="og:image" content="{{ site_url }}{{ avatar }}" />
        <meta property="og:image:alt" content="Portrait of {{ info.name }}" />
        {% endif %}
        <meta name="twitter:card" content="summary" />
        {% if twitter_handle %}
        <meta name="twitter:site" content="{{ twitter_handle }}" />
        <meta name="twitter:creator" content="{{ twitter_handle }}" />
        {% endif %}

        <script type="application/ld+json">
{{ json_ld }}
        </script>
    </head>
    <body class="bg-body-custom">
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="d-flex flex-column min-vh-100">
            <main id="main" class="flex-grow-1">
                <div class="container-xxl py-4">
                    <div class="row g-4">
                        <!-- Sidebar / Profile -->
                        <aside class="col-12 col-md-4">
                            <div class="card sidebar-card">
                                <div class="card-body">
                                    <div class="profile-header mb-3">
                                        {% if avatar %}
                                        <div class="profile-photo-wrapper mb-2">
                                            <picture>
                                                {% if avatar_webp %}
                                                <source srcset="{{ avatar_webp }}" type="image/webp" />
                                                {% endif %}
                                                <img
                                                    class="profile-photo"
                                                    src="{{ avatar }}"
                                                    alt="Portrait of {{ info.name }}"
                                                    {% if avatar_w %}width="{{ avatar_w }}" height="{{ avatar_h }}"{% endif %}
                                                />
                                            </picture>
                                        </div>
                                        {% endif %}
                                        <h1 class="profile-name">{{ info.name }}</h1>
                                        <div class="profile-title">{{ info.title }}</div>
                                        <div class="profile-affiliation">{{ affiliation }}</div>
                                        {% if info.location and info.location != info.affiliation2 %}
                                        <div class="profile-location">{{ info.location }}</div>
                                        {% endif %}
                                    </div>

                                    {% if emails %}
                                    <div class="mb-3">
                                        <h2 class="section-label">Contact</h2>
                                        {% for e in emails %}
                                        <div class="profile-text{% if not loop.first %} mt-1{% endif %}">
                                            <a class="js-email" href="#" data-user="{{ e.user }}" data-domain="{{ e.domain }}">{{ e.user }} [at] {{ e.domain }}</a>
                                        </div>
                                        {% endfor %}
                                    </div>
                                    {% endif %}

                                    {% if social %}
                                    <div class="mb-3">
                                        <h2 class="section-label">Online</h2>
                                        <div class="d-flex flex-wrap gap-2 mt-1 justify-content-center">
                                            {% for link in social %}
                                            <a class="profile-chip" href="{{ link.url }}" target="_blank" rel="noopener me">{{ link.label }}</a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    {% endif %}

                                    {% if info.researchTopics %}
                                    <div class="mb-3">
                                        <h2 class="section-label">Research Interests</h2>
                                        <ul class="research-topics mt-1">
                                            {% for topic in info.researchTopics %}
                                            <li>{{ topic }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                    {% endif %}

                                    {% if info.openToInternships and info.internshipNote %}
                                    <div class="mb-3">
                                        <h2 class="section-label">Internships</h2>
                                        <div class="internship-note mt-1">{{ info.internshipNote }}</div>
                                    </div>
                                    {% endif %}

                                    {% if info.cvUrl %}
                                    <div class="mb-1">
                                        <h2 class="section-label">CV</h2>
                                        <div class="profile-text mt-1">
                                            <a href="{{ info.cvUrl }}" target="_blank" rel="noopener">Download CV (PDF)</a>
                                        </div>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </aside>

                        <!-- Main content -->
                        <div class="col-12 col-md-8">
                            <!-- Top section nav -->
                            <nav class="card sections-card mb-3" aria-label="Sections">
                                <div class="card-body py-2 d-flex align-items-center gap-3 sections-nav">
                                    <div class="sections-label" aria-hidden="true">Sections</div>
                                    <div class="nav flex-nowrap">
                                        <a class="nav-link nav-link-compact" href="#about">About</a>
                                        {% if news %}<a class="nav-link nav-link-compact" href="#news">News</a>{% endif %}
                                        {% if pub_groups %}<a class="nav-link nav-link-compact" href="#publications">Publications</a>{% endif %}
                                        <a class="nav-link nav-link-compact" href="#activities">Activities</a>
                                    </div>
                                    <button
                                        type="button"
                                        class="theme-toggle ms-auto"
                                        id="theme-toggle"
                                        aria-label="Toggle dark mode"
                                        title="Toggle dark mode"
                                        hidden
                                    >
                                        <span aria-hidden="true">◐</span>
                                    </button>
                                </div>
                            </nav>

                            <!-- About -->
                            <section id="about" class="card card-section mb-3">
                                <div class="card-body">
                                    <h2 class="section-title">About Me</h2>
                                    <div class="section-body">
                                        {% for p in about %}
                                        <p>{{ p }}</p>
                                        {% endfor %}
                                    </div>
                                </div>
                            </section>

                            {% if news %}
                            <!-- News -->
                            <section id="news" class="card card-section mb-3">
                                <div class="card-body">
                                    <h2 class="section-title">News</h2>
                                    <ul class="list-unstyled section-list news-list">
                                        {% for item in news %}
                                        <li>
                                            <span class="news-date">{{ item.label }}</span>
                                            <span>
                                                {% if item.url %}
                                                <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.text }}</a>
                                                {% else %}
                                                {{ item.text }}
                                                {% endif %}
                                            </span>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </section>
                            {% endif %}

                            {% if pub_groups %}
                            <!-- Publications -->
                            <section id="publications" class="card card-section mb-3">
                                <div class="card-body">
                                    <h2 class="section-title">Publications</h2>
                                    {% for group in pub_groups %}
                                    <h3 class="pub-year">{{ group.year }}</h3>
                                    <div class="pub-list-cards">
                                        {% for pub in group.pubs %}
                                        <article class="pub-card">
                                            <h4 class="pub-card-title">
                                                {% if pub.venueShort %}<span class="pub-venue-badge">{{ pub.venueShort }}</span>{% endif %}
                                                {% if pub.primaryUrl %}
                                                <a class="pub-card-link" href="{{ pub.primaryUrl }}" target="_blank" rel="noopener">{{ pub.title }}</a>
                                                {% else %}
                                                {{ pub.title }}
                                                {% endif %}
                                            </h4>
                                            <div class="pub-card-meta">
                                                {% for a in pub.authorList %}{% if a.me %}<strong>{{ a.name }}</strong>{% else %}{{ a.name }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                                                {% if pub.venue %}<br /><em>{{ pub.venue }}</em>{% endif %}{% if pub.year %}, {{ pub.year }}{% endif %}
                                            </div>

                                            {% if pub.image %}
                                            <div class="pub-card-image-block">
                                                <picture>
                                                    {% if pub.imageWebp %}
                                                    <source srcset="{{ pub.imageWebp }}" type="image/webp" />
                                                    {% endif %}
                                                    <img
                                                        class="pub-card-image"
                                                        src="{{ pub.image }}"
                                                        alt="Overview figure for “{{ pub.title }}”"
                                                        loading="lazy"
                                                        decoding="async"
                                                        {% if pub.imageWidth %}width="{{ pub.imageWidth }}" height="{{ pub.imageHeight }}"{% endif %}
                                                    />
                                                </picture>
                                            </div>
                                            {% endif %}

                                            <div class="pub-card-chips">
                                            {% for chip in pub.chips %}
                                            <a class="pub-chip" href="{{ chip.url }}" target="_blank" rel="noopener">{{ chip.label }}</a>
                                            {% endfor %}
                                            {% if pub.summary %}
                                            <details class="pub-details">
                                                <summary class="pub-chip">Abstract</summary>
                                                <p class="pub-abstract">{{ pub.summary | trim }}{% if pub.summary | length >= 340 %}…{% endif %}</p>
                                            </details>
                                            {% endif %}
                                            <details class="pub-details">
                                                <summary class="pub-chip">BibTeX</summary>
                                                <div class="pub-bibtex-wrap">
                                                    <button type="button" class="pub-chip pub-copy" hidden>Copy</button>
                                                    <pre class="pub-bibtex">{{ pub.bibtex }}</pre>
                                                </div>
                                            </details>
                                            </div>
                                        </article>
                                        {% endfor %}
                                    </div>
                                    {% endfor %}
                                </div>
                            </section>
                            {% endif %}

                            <!-- Teaching, Honors & Service -->
                            <section id="activities" class="card card-section mb-3">
                                <div class="card-body">
                                    <h2 class="section-title">Academic Activities</h2>
                                    {% if teaching %}
                                    <h3 class="section-subheading">Teaching</h3>
                                    <ul class="section-list">
                                        {% for t in teaching %}
                                        <li>
                                            <span class="teaching-term">{{ t.term }}</span>
                                            {% if t.url %}<a href="{{ t.url }}" target="_blank" rel="noopener">{{ t.course }}</a>{% else %}{{ t.course }}{% endif %}{% if t.role %} — {{ t.role }}{% endif %}
                                        </li>
                                        {% endfor %}
                                    </ul>
                                    {% endif %}
                                    {% if awards %}
                                    <h3 class="section-subheading">Honors &amp; Awards</h3>
                                    <ul class="section-list">
                                        {% for a in awards %}<li>{{ a }}</li>{% endfor %}
                                    </ul>
                                    {% endif %}
                                    {% if service %}
                                    <h3 class="section-subheading">Service</h3>
                                    <ul class="section-list">
                                        {% for s in service %}<li>{{ s }}</li>{% endfor %}
                                    </ul>
                                    {% endif %}
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </main>

            <footer class="border-top py-3 footer-text">
                <div class="container-xxl d-flex flex-wrap justify-content-between gap-2">
                    <div>© {{ year }} {{ info.name }}</div>
                    <div>{{ footer_note }} · Last updated {{ today }}</div>
                </div>
            </footer>
        </div>

        <script src="site.js" defer></script>
    </body>
</html>
