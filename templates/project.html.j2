<!doctype html>
<!-- Generated by scripts/build.py from projects/{{ p.slug }}/project.json — edit that, not this file. -->
{% set ICONS = {
    "pdf": '<path d="M6 2h8l6 6v14H6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 2v6h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
    "arxiv": '<path d="M5 4l14 16M19 4L5 20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>',
    "code": '<path d="M9 7l-5 5 5 5M15 7l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>',
    "data": '<ellipse cx="12" cy="6" rx="7" ry="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" fill="none" stroke="currentColor" stroke-width="2"/>',
    "model": '<path d="M12 2l9 5v10l-9 5-9-5V7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M3 7l9 5 9-5M12 12v10" fill="none" stroke="currentColor" stroke-width="2"/>',
    "image": '<rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="9" cy="10" r="2" fill="currentColor"/><path d="M21 17l-5-5-9 8" fill="none" stroke="currentColor" stroke-width="2"/>',
    "gif": '<rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9v6l5-3z" fill="currentColor"/>',
    "video": '<rect x="2" y="5" width="15" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M17 10l5-3v10l-5-3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
} %}
{% macro icon(name) %}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">{{ ICONS[name] | safe }}</svg>{% endmacro %}

{# A media slot: the real file if it exists in projects/<slug>/media/, otherwise a labelled placeholder. #}
{% macro media(id, with_caption=true, alt="") %}
{% set m = p.media[id] %}
<figure class="figure" id="fig-{{ id }}">
    {% if m.exists %}
        {% if m.kind == "video" %}
        {# Native controls: play/pause, timeline scrubbing, fullscreen. Autoplay is skipped for reduced motion (project.js). #}
        <video class="figure-media" src="{{ m.src }}"{% if m.poster %} poster="{{ m.poster }}"{% endif %} controls autoplay muted loop playsinline preload="metadata" aria-label="{{ m.caption or m.todo }}" style="aspect-ratio: {{ m.aspect }}"></video>
        {% else %}
        <picture>
            {% if m.webp %}<source srcset="{{ m.webp }}" type="image/webp" />{% endif %}
            <img class="figure-media" src="{{ m.src }}" alt="{{ alt or m.caption or m.todo }}" loading="lazy" decoding="async" style="aspect-ratio: {{ m.aspect }}" />
        </picture>
        {% endif %}
    {% else %}
        <div class="placeholder" style="aspect-ratio: {{ m.aspect }}" role="img" aria-label="Placeholder for {{ m.file }}">
            {{ icon(m.kind) }}
            <div class="placeholder-kind">{{ m.kind | upper }} PLACEHOLDER</div>
            <code class="placeholder-file">media/{{ m.file }}</code>
            <p class="placeholder-todo">{{ m.todo }}</p>
        </div>
    {% endif %}
    {% if with_caption and m.caption %}<figcaption>{{ m.caption }}</figcaption>{% endif %}
</figure>
{% endmacro %}

{% macro render_block(b) %}
{% if b.type == "p" %}
<p>{{ b.html | safe }}</p>
{% elif b.type == "html" %}
{{ b.html | safe }}
{% elif b.type == "list" %}
<ul class="bullets">{% for it in b["items"] %}<li>{{ it | safe }}</li>{% endfor %}</ul>
{% elif b.type == "media" %}
{{ media(b.id) }}
{% elif b.type == "cards" %}
<ol class="steps">
    {% for c in b["items"] %}
    <li class="step">
        <span class="step-num">{{ c.step }}</span>
        <h3>{{ c.title }}</h3>
        <p>{{ c.text }}</p>
    </li>
    {% if not loop.last %}<li class="step-arrow" aria-hidden="true">→</li>{% endif %}
    {% endfor %}
</ol>
{% elif b.type == "stats" %}
<div class="stats">
    {% for s in b["items"] %}
    <div class="stat">
        <div class="stat-value">{{ s.value }}</div>
        <div class="stat-label">{{ s.label }}</div>
        <div class="stat-note">{{ s.note }}</div>
    </div>
    {% endfor %}
</div>
{% elif b.type == "bars" %}
{% set maxv = b["items"] | map(attribute="value") | max %}
<figure class="bars">
    <figcaption>{{ b.title }}</figcaption>
    {% for it in b["items"] %}
    <div class="bar-row{% if it.highlight %} is-ours{% endif %}">
        <span class="bar-label">{{ it.label }}</span>
        <span class="bar-track"><span class="bar-fill" style="width: {{ (it.value / maxv * 100) | round(1) }}%"></span></span>
        <span class="bar-value">{{ "%.2f" | format(it.value) }}{{ b.unit }}</span>
    </div>
    {% endfor %}
</figure>
{% elif b.type == "table" %}
<div class="table-wrap">
    <table>
        <caption>{{ b.caption }}</caption>
        <thead><tr>{% for h in b.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
            {% for row in b.rows %}
            <tr>{% for cell in row %}{% if loop.first %}<th scope="row">{{ cell | safe }}</th>{% else %}<td>{{ cell | safe }}</td>{% endif %}{% endfor %}</tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% elif b.type == "code" %}
<div class="code-block">
    {% if b.label %}<div class="code-label">{{ b.label }}</div>{% endif %}
    <pre><code>{{ b.text }}</code></pre>
</div>
{% elif b.type == "cases" %}
<h3 class="cases-title">{{ b.title }}</h3>
<div class="cases">
    {% for c in b["items"] %}
    <article class="case">
        {{ media(c.media, with_caption=false) }}
        <div class="case-labels">
            <span class="tag tag-gt">Dataset label: {{ c.gt }}</span>
            <span class="tag {% if c.gt == c.pred %}tag-ok{% else %}tag-diff{% endif %}">PeqEMO: {{ c.pred }}</span>
        </div>
        {% if c.note %}<p class="case-note">{{ c.note | safe }}</p>{% endif %}
        <p class="case-text">{{ c.text }}</p>
    </article>
    {% endfor %}
</div>
{% elif b.type == "explorer" %}
<div class="explorer" data-explorer>
    <div class="explorer-images" role="tablist" aria-label="Choose an image">
        {% for img in p.explorer %}
        <button type="button" class="thumb" role="tab" data-image="{{ img.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}" hidden>{{ img.label }}</button>
        {% endfor %}
    </div>
    {% for img in p.explorer %}
    <section class="explorer-panel" data-panel="{{ img.id }}" aria-label="{{ img.label }}">
        <div class="explorer-media">
            <h3 class="explorer-panel-title">{{ img.label }}</h3>
            {{ media(img.media, with_caption=false, alt=img.alt) }}
        </div>
        <div class="explorer-text">
            <div class="emotion-chips" role="tablist" aria-label="Condition on an emotion" hidden>
                {% for j in img.justifications %}
                <button type="button" class="chip{% if j.emotion == img.groundTruth %} is-gt{% endif %}" role="tab" data-emotion="{{ j.emotion }}" aria-selected="{{ 'true' if j.emotion == img.groundTruth else 'false' }}">{{ j.emotion }}</button>
                {% endfor %}
            </div>
            {% for j in img.justifications %}
            <details class="justification" data-justification="{{ j.emotion }}"{% if j.emotion == img.groundTruth %} open{% endif %}>
                <summary>
                    Explain it as <b>{{ j.emotion | lower }}</b>
                    {% if j.emotion == img.groundTruth %}<span class="gt-pill">dataset label</span>{% endif %}
                </summary>
                <div class="jst">
                    <p class="jst-part"><span class="jst-tag tag-perception">Perception</span> {{ j.perception }}</p>
                    <p class="jst-part"><span class="jst-tag tag-trigger">Trigger</span> {{ j.trigger }}</p>
                    <p class="jst-part"><span class="jst-tag tag-label">Label</span> <b>{{ j.emotion }}</b></p>
                </div>
            </details>
            {% endfor %}
        </div>
    </section>
    {% endfor %}
</div>
{% endif %}
{% endmacro %}
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <!-- Apply the saved theme (shared with the homepage) before first paint to avoid a flash -->
        <script>
            try {
                var t = localStorage.getItem("theme");
                if (t) document.documentElement.setAttribute("data-theme", t);
            } catch (e) {}
        </script>
        <title>{{ p.short }}: {{ p.title }}</title>
        <meta name="description" content="{{ p.description }}" />
        <link rel="canonical" href="{{ page_url }}" />
        <link rel="icon" href="../assets/favicon.svg" type="image/svg+xml" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ p.short }}: {{ p.title }}" />
        <meta property="og:description" content="{{ p.description }}" />
        <meta property="og:url" content="{{ page_url }}" />
        {% if og_image %}
        <meta property="og:image" content="{{ og_image }}" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        {% endif %}
        <link rel="preload" href="../assets/fonts/NotoSans-400.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="stylesheet" href="../project.css?v={{ css_v }}" />
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode" hidden>
            <span aria-hidden="true">◐</span>
        </button>
        <header class="hero">
            <div class="container">
                <p class="hero-short">{{ p.short }}</p>
                <h1 class="hero-title">{{ p.title }}</h1>
                <p class="hero-authors">
                    {% for a in p.authors %}{% if a.url %}<a href="{{ a.url }}">{{ a.name }}</a>{% else %}{{ a.name }}{% endif %}{% if a.affiliations %}<sup>{{ a.affiliations | join(",") }}</sup>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
                </p>
                {% if p.affiliations %}
                <p class="hero-affils">{% for af in p.affiliations %}<span><sup>{{ loop.index }}</sup>{{ af }}</span>{% endfor %}</p>
                {% endif %}
                <p class="hero-venue">{{ p.venue }}</p>
                <nav class="hero-links" aria-label="Paper resources">
                    {% for l in p.links %}
                    {% if l.url %}
                    <a class="btn" href="{{ l.url }}" target="_blank" rel="noopener">{{ icon(l.icon) }}<span>{{ l.label }}</span></a>
                    {% else %}
                    <span class="btn is-disabled" title="Coming soon" aria-disabled="true">{{ icon(l.icon) }}<span>{{ l.label }}</span><small>soon</small></span>
                    {% endif %}
                    {% endfor %}
                </nav>
            </div>
        </header>

        <main id="main">
            <section class="container teaser">
                {{ media(p.teaser) }}
                <div class="tldr">
                    <span class="tldr-label">TL;DR</span>
                    <p>{{ p.tldr | safe }}</p>
                </div>
                <div class="detail-toggle">
                    <button type="button" id="toggle-details" aria-pressed="false" hidden>Show all details</button>
                </div>
            </section>

            {% for s in p.sections %}
            <section class="container section" id="{{ s.id }}">
                <h2 class="section-title">{{ s.title }}</h2>
                {% for b in s.blocks %}{{ render_block(b) }}{% endfor %}
                {% if s.deeper %}
                <details class="deeper">
                    <summary>{{ s.deeper.summary }}</summary>
                    <div class="deeper-body">
                        {% for b in s.deeper.blocks %}{{ render_block(b) }}{% endfor %}
                    </div>
                </details>
                {% endif %}
            </section>
            {% endfor %}

            <section class="container section" id="bibtex">
                <h2 class="section-title">BibTeX</h2>
                <div class="code-block">
                    <button type="button" class="copy-btn" data-copy="#bibtex-code" hidden>Copy</button>
                    <pre><code id="bibtex-code">{{ p.bibtex }}</code></pre>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="container">
                <p><a href="../">← Back to Josep's homepage</a></p>
                <p class="footer-small">Page layout inspired by the <a href="https://github.com/nerfies/nerfies.github.io">Nerfies</a> project page template. Last updated {{ today }}.</p>
            </div>
        </footer>

        <script src="../project.js?v={{ js_v }}" defer></script>
    </body>
</html>
